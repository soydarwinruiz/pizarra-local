{
  "name": "pizarra-local",
  "productName": "Pizarra Local",
  "version": "1.1.0",
  "description": "Pizarra infinita colaborativa 100% local (estilo Miro)",
  "main": "main.js",
  "author": "Pizarra Local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.pizarra.app",
    "productName": "Pizarra Local",
    "files": [
      "index.html",
      "main.js",
      "icon.png"
    ],
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pizarra Local"
    },
    "portable": {
      "artifactName": "PizarraLocal-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Pizarra Local"
    },
    "publish": null
  }
}
